# Production Environment Variables
# Copy this file to .env for local development
# DO NOT commit .env to version control

# Database - Neon PostgreSQL
# Get your connection string from: https://neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@your-neon-hostname.neon.tech/neondb?sslmode=require"

# For connection pooling (recommended for serverless)
# DIRECT_URL="postgresql://user:password@your-neon-hostname.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Site Configuration
# For production, use your actual domain
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact Form (Optional - if using external service)
# NEXT_PUBLIC_CONTACT_EMAIL=info@auxiliumconsult.com

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Cloudinary - File Upload & Storage
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend - Email Notifications
# Sign up at: https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxx"
EMAIL_FROM="Auxilium Consult <noreply@yourdomain.com>"

# API Keys (if needed)
# Add your production API keys here
