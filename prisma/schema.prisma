// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          UserRole  @default(CLIENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  client        Client?
  activityLogs  ActivityLog[]
}

enum UserRole {
  ADMIN
  CLIENT
}

// Client model for client details
model Client {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Company Information
  companyName       String
  contactPerson     String
  phoneNumber       String
  address           String?
  city              String?
  country           String          @default("Ghana")
  industry          String?
  
  // Engagement Details
  engagementStatus  EngagementStatus @default(INQUIRY)
  engagementDate    DateTime?
  engagementFee     Float?
  engagementFeePaid Boolean         @default(false)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  // Relations
  projects          Project[]
  documents         Document[]
  messages          Message[]
  notes             Note[]
}

enum EngagementStatus {
  INQUIRY
  QUALIFIED
  ENGAGED
  ACTIVE
  COMPLETED
  INACTIVE
}

// Project model for funding projects
model Project {
  id                  String        @id @default(cuid())
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  // Project Details
  projectName         String
  description         String
  sector              Sector
  fundingRequired     Float
  fundingSecured      Float         @default(0)
  
  // Status and Progress
  status              ProjectStatus @default(INTAKE)
  currentStage        Int           @default(1) // 1-5 for the 5 stages
  progressPercentage  Int           @default(0)
  
  // Dates
  startDate           DateTime      @default(now())
  targetCloseDate     DateTime?
  actualCloseDate     DateTime?
  
  // Milestones
  intakeComplete      Boolean       @default(false)
  dueDiligenceComplete Boolean      @default(false)
  investorEngaged     Boolean       @default(false)
  fundingFacilitated  Boolean       @default(false)
  postFundingSupport  Boolean       @default(false)
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  // Relations
  documents           Document[]
  updates             ProjectUpdate[]
  milestones          Milestone[]
}

enum Sector {
  ENERGY
  AGRIBUSINESS
  MINING
  INDUSTRY
  FINTECH
  OTHER
}

enum ProjectStatus {
  INTAKE              // Client Intake & Qualification
  DUE_DILIGENCE       // Due Diligence & Structuring
  INVESTOR_ENGAGEMENT // Investor Engagement
  FUNDING             // Funding Facilitation
  POST_FUNDING        // Post-Funding Support
  COMPLETED
  ON_HOLD
  CANCELLED
}

// Project updates and timeline
model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title       String
  description String
  stage       Int
  createdBy   String   // Admin who created the update
  createdAt   DateTime @default(now())
}

// Milestones for project tracking
model Milestone {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title         String
  description   String?
  dueDate       DateTime?
  completedDate DateTime?
  isCompleted   Boolean  @default(false)
  order         Int
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Document management
model Document {
  id          String       @id @default(cuid())
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  fileName    String
  fileType    String
  fileSize    Int
  filePath    String
  category    DocumentCategory
  uploadedBy  String       // User ID or "admin"
  description String?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum DocumentCategory {
  BUSINESS_PLAN
  FINANCIAL_STATEMENTS
  PITCH_DECK
  DUE_DILIGENCE
  LEGAL
  CONTRACTS
  REPORTS
  OTHER
}

// Messaging system
model Message {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  subject     String
  content     String
  sender      MessageSender
  senderName  String
  isRead      Boolean       @default(false)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum MessageSender {
  CLIENT
  ADMIN
}

// Admin notes on clients
model Note {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  content     String
  createdBy   String   // Admin name
  isPrivate   Boolean  @default(true) // Only visible to admins
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Activity logs for audit trail
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action      String
  entity      String   // e.g., "Project", "Client", "Document"
  entityId    String?
  description String
  ipAddress   String?
  
  createdAt   DateTime @default(now())
}
